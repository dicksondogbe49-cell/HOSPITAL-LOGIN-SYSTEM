PORT=3000
NODE_ENV=development
TRUST_PROXY=false
ALLOWED_ORIGIN=

# Initial Administrator Account (created automatically on first startup)
BOOTSTRAP_ADMIN_USERNAME=dicksondogbe49@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password-min-12-chars

# Cryptographic Secrets (each must be at least 32 characters)
PASSWORD_PEPPER=replace-with-a-random-secret-of-at-least-32-characters
SESSION_SECRET=replace-with-another-random-secret-of-at-least-32-characters

# Email / 2FA & Encrypted Backup Delivery (defaults to Gmail when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_IGNORE_TLS=false
SMTP_USER=dicksondogbe49@gmail.com
SMTP_APP_PASSWORD=replace-with-your-smtp-or-google-app-password
BACKUP_EMAIL=dicksondogbe49@gmail.com
OTP_SHARED_EMAIL=dicksondogbe49@gmail.com

# Storage & Backup Retention
DATA_DIRECTORY=data
BACKUP_DIRECTORY=backups
MAX_LOCAL_BACKUPS=10
AUTO_BACKUP_INTERVAL_MINUTES=30

# Optional AWS S3 Offsite Backups (credentials may be supplied by an AWS IAM role instead)
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PREFIX=database-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
